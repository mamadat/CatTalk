OPENROUTER_TRANSLATION_QUALITY_MODEL=openrouter/free
OPENROUTER_TRANSLATION_FAST_MODEL=openrouter/free

GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_STT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

OLLAMA_URL=http://127.0.0.1:11434
LIBRETRANSLATE_URL=http://127.0.0.1:5000
TRANSLATEGEMMA_TRANSLATION_MODEL=translategemma:4b
TRANSLATEGEMMA_TRANSLATION_QUALITY_MODEL=translategemma:4b
TRANSLATEGEMMA_TRANSLATION_FAST_MODEL=translategemma:4b
QWENLOCAL_TRANSLATION_MODEL=qwen3:4b
QWENLOCAL_TRANSLATION_QUALITY_MODEL=qwen3:4b
QWENLOCAL_TRANSLATION_FAST_MODEL=qwen3:4b

TELEGRAM_BOT_TOKEN=
