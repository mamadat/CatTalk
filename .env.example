# Server only. Never use EXPO_PUBLIC_ for a provider key.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-6.1-sol
OPENAI_TRANSLATION_QUALITY_MODEL=gpt-6-astra
OPENAI_TRANSLATION_FAST_MODEL=gpt-6-luna
TRANSLATION_HOST=127.0.0.1
TRANSLATION_PORT=8787

# Required if you bind to a LAN/public address. This is a separate gateway token.
TRANSLATION_ACCESS_TOKEN=
# Comma-separated web origins. Do not use *.
TRANSLATION_ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# Optional PUBLIC address of your backend for the mobile app (no secret here).
EXPO_PUBLIC_TRANSLATION_URL=
