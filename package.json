    "expo-linking": "~8.0.12",
    "expo-share-intent": "~5.1.0",
    "expo-speech": "~14.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
